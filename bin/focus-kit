#!/usr/bin/env bash
# Copyright (C) 2026 J.C. Ködel. Licensed under AGPL-3.0-only. Source and terms: https://github.com/JCKodel/focus-kit
# focus-kit: install the FOCUS delivery process into a repository.
#
#   focus-kit install [path]   install or update the kit in a repository (default: .)
#   focus-kit update  [path]   same as install; kept as a verb people expect
#   focus-kit doctor  [path]   report what is installed, what is missing, and what update would change
#   focus-kit version          print the kit version
#   focus-kit selftest         run the six checks that say the kit is deliverable
#
# What install does, in order:
#   1. dependencies on this machine: uv, then graphify (uv tool), then the
#      graphify skill for each host the kit ships commands for, one line each,
#      installed when absent and refreshed when it is older than the package
#      (graphify install --platform <platform>), then whether this clone is
#      behind the origin it was cloned from, which warns and never pulls
#   2. in the target repository:
#      .claude/skills/<command>/                   copied, overwriting (kit-owned)
#      .claude/skills/.focus-kit-version           which version is installed, for doctor (kit-owned)
#      docs/manuals/{process,focus,graphify}.md    copied, overwriting (kit-owned)
#      .github/prompts/<command>.prompt.md         generated from the skill, overwriting (kit-owned)
#      .claude/skills/.focus-kit-manifest          what install wrote, for doctor (kit-owned)
#      .claude/settings.json                       baseline permissions merged in
#      .gitignore                                  kit fragment appended once
#      .graphifyignore                             kit fragment appended once
#      work/done/.gitkeep                          created if absent
#   3. prints the next step: open Claude Code in the repository and run /initialize
#
# The prompt files are the same commands for a host that reads
# .github/prompts instead of .claude/skills: generated from the skills at
# install time, never authored beside them, so the two can never disagree.
#
# Everything the kit owns is overwritten on update. Everything the project owns
# (docs/00 to 06, CLAUDE.md, ADRs, work/, .claude/skills/.focus-kit-language)
# is never touched here: that is /initialize's job, and it merges instead of
# overwriting. The manuals are the kit's, so update writes them back in
# English over a translation /initialize made; doctor names each one.
#
# Runs on macOS (bash 3.2), Linux, and Windows through WSL or Git Bash. Needs
# curl and a python 3 on PATH, as python3 or as python (or uv, which can
# supply one).

set -euo pipefail

# Resolve the script's real location, through symlinks (readlink -f is not
# on every macOS; this loop is).
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF" ;; esac
done
KIT_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
KIT_VERSION="$(cat "$KIT_DIR/VERSION")"

say()  { printf '%s\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# Echoes the interpreter and returns 0, or prints nothing and returns 1. It
# does not die: its output is captured, and a die inside $(...) ends only the
# subshell, so the caller would carry on with an empty answer
# (docs/01-Architecture.md §6). merge_json is where the failure becomes a die.
#
# Each candidate is probed by running it, not by asking command -v whether it
# is on PATH. On Windows, python3 is usually the Microsoft Store stub: on
# PATH, and a failure when executed. And python.org installs python, not
# python3. The probe also skips a python that is 2.7. uv stays a PATH
# question, because probing it would download an interpreter to answer which
# interpreter to use; --no-project keeps it from creating a .venv and a
# uv.lock inside a target that has a pyproject.toml.
python_bin() {
  local cand
  for cand in python3 python; do
    if "$cand" -c 'import json, sys; sys.exit(sys.version_info[0] != 3)' >/dev/null 2>&1; then
      echo "$cand"; return
    fi
  done
  if command -v uv >/dev/null 2>&1; then echo "uv run --no-project --python 3.12 python"; return; fi
  return 1
}

# ---------------------------------------------------------------- dependencies

ensure_uv() {
  if command -v uv >/dev/null 2>&1; then ok "uv $(uv --version | awk '{print $2}')"; return; fi
  say "  installing uv (https://astral.sh/uv)"
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$PATH"
  command -v uv >/dev/null 2>&1 || die "uv installed but not on PATH; open a new shell and run again"
  ok "uv installed"
}

# The lower of two dotted version numbers, field by field and numerically, or
# a string comparison would put 0.9.10 before 0.9.8 and call the newer of the
# two older. Two callers, global_skill_state and report_upstream, which is
# what makes it a function: the first held the sort alone until the second
# asked the same question of the clone and its origin (CLAUDE.md, abstraction
# on the second concrete occurrence).
#
# It reads and never dies: its output is captured, and a die inside $(...)
# ends only the subshell (docs/01-Architecture.md §6).
version_lower() { # a b
  printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | head -1
}

# The Hosts the kit ships Commands for (docs/03-Domain.md, Host), one line
# each, "<platform> <directory under HOME> <host name>": the name graphify's
# own installer takes after --platform, the directory that installer places
# that Host's skill and its Skill stamp in, and the name a person reads. The
# host name is last because it is the one field with a space in it, so a
# "read -r platform dir host" gets all of it.
#
# This is the Host list and the only one: a third Host is a line here, plus
# an entry in render_prompt's substitution list for its Ported command. Read
# off graphify 0.9.63, whose "graphify install --help" names both platforms
# and whose installer writes SKILL.md, references/ and .graphify_version
# under the directory below and nothing into the target: a route that wrote
# into the target would be a Host the kit warns about instead of installing,
# since the script never touches a project-owned file (docs/00-Product.md,
# Installing).
#
# It reads and never dies: its output is captured, and a die inside $(...)
# ends only the subshell (docs/01-Architecture.md §6).
kit_hosts() {
  printf '%s\n' \
    'claude .claude/skills/graphify Claude Code' \
    'copilot .copilot/skills/graphify GitHub Copilot'
}

# The state of one Host's Global skill against the graphify package
# (docs/03-Domain.md, Global skill and Skill stamp), asked with that Host's
# directory as kit_hosts names it. One line,
# "<state> <skill> <package>", a number it could not read written as "-":
#
#   missing   the Host's SKILL.md under $HOME is not there
#   unknown   the skill is there and the stamp is not, or graphify is not on PATH
#   equal     the stamp and the second word of "graphify --version" are the same
#   older     they differ and the stamp is the lower of the two
#   newer     they differ and the package is the lower of the two
#
# The order is version_lower's, numeric field by field and not a string
# comparison, or 0.9.10 would sort before 0.9.8 and a newer skill would read
# as older. The stamp is
# the same file graphify reads to print its own stale-skill notice, so the kit
# reaches graphify's verdict without reading graphify's stderr
# (docs/04-Conventions.md §1).
#
# It reads and never dies: its output is captured, and a die inside $(...)
# ends only the subshell (docs/01-Architecture.md §6).
global_skill_state() { # directory under HOME, from kit_hosts
  local dir="$HOME/$1" skill="-" package="-" lower
  [ -f "$dir/SKILL.md" ] || { echo "missing - -"; return; }
  if [ -s "$dir/.graphify_version" ]; then
    skill="$(without_cr "$dir/.graphify_version")"
    [ -n "$skill" ] || skill="-"
  fi
  if command -v graphify >/dev/null 2>&1; then
    package="$(graphify --version 2>/dev/null | head -1 | awk '{print $2}')"
    [ -n "$package" ] || package="-"
  fi
  if [ "$skill" = "-" ] || [ "$package" = "-" ]; then echo "unknown $skill $package"; return; fi
  if [ "$skill" = "$package" ]; then echo "equal $skill $package"; return; fi
  lower="$(version_lower "$skill" "$package")"
  if [ "$lower" = "$skill" ]; then echo "older $skill $package"; else echo "newer $skill $package"; fi
}

# graphify is installed as a uv tool, plain. The mcp extra left with
# mcp-leaves-the-baseline: nothing the kit ships calls the MCP server, so the
# kit no longer installs what it would need. The install runs unconditionally
# rather than behind a "command -v graphify", because that is the only way a
# machine that installed graphifyy[mcp] under an earlier kit ever reaches the
# plain requirement: uv reinstalls when the requirement differs and prints
# "is already installed" when it does not. It does not upgrade a graphify
# that is merely old, which is why the ok line names uv tool upgrade.
ensure_graphify() {
  local out
  if out="$(uv tool install graphifyy 2>&1)"; then
    case "$out" in
      *"is already installed"*) ;;
      *) say "  installing graphify (uv tool install graphifyy)"
         printf '%s\n' "$out" ;;
    esac
  else
    printf '%s\n' "$out"
    die "graphify could not be installed (uv tool install graphifyy)"
  fi
  export PATH="$HOME/.local/bin:$PATH"
  command -v graphify >/dev/null 2>&1 || die "graphify installed but not on PATH; open a new shell and run again"
  # graphify --version already prints the word "graphify", so the line uses it
  # as it comes and does not repeat the name. Its stderr is dropped: graphify
  # writes its own notices there, and a line the kit did not shape has no
  # business in the middle of the dependency block (docs/04-Conventions.md §1).
  ok "$(graphify --version 2>/dev/null) (to upgrade: uv tool upgrade graphifyy)"
  # The Global skill, once per Host the kit ships Commands for (kit_hosts):
  # installed when absent, refreshed when it is older than the package or
  # carries no stamp, left alone when it is newer, because graphify's own
  # installer would downgrade it. A refresh is not a file the kit keeps
  # rewriting: graphify's installer copies the skill, its references/ and the
  # stamp, and the kit writes none of them itself. graphify is on PATH by
  # here, so "unknown" in this block means no stamp.
  #
  # One line per Host and never a count, the way the Translated manual, the
  # Fragment gap and the Manual citation passes already print one line per
  # thing to fix. A Host whose skill graphify's installer does not place is a
  # failure inside the flow and not a defect, so it warns, names what would
  # have placed it, and the install goes on (docs/01-Architecture.md §6).
  #
  # The loop reads kit_hosts through a herestring and not a pipe, so its body
  # runs in this shell; the installer gets </dev/null so nothing it reads can
  # swallow the remaining host lines.
  local platform dir host state skill package
  while read -r platform dir host; do
    [ -n "$platform" ] || continue
    read -r state skill package <<< "$(global_skill_state "$dir")"
    case "$state" in
      equal) ok "graphify skill for $host" ;;
      newer) warn "graphify skill for $host $skill is newer than graphify $package (uv tool upgrade graphifyy)" ;;
      *)
        if graphify install --platform "$platform" >/dev/null 2>&1 </dev/null; then
          case "$state" in
            missing) ok "graphify skill for $host (installed)" ;;
            unknown) ok "graphify skill for $host (refreshed from an unknown version)" ;;
            *)       ok "graphify skill for $host (refreshed from $skill)" ;;
          esac
        else
          warn "could not install the graphify skill for $host (graphify install --platform $platform)"
        fi
        ;;
    esac
  done <<< "$(kit_hosts)"
}

# The Upstream version (docs/03-Domain.md): the VERSION at the default branch
# of the clone's own origin, against KIT_VERSION. One function, because one
# state has one wording, and two callers say it: doctor's machine block and
# the dependencies block of install and update, which is the run that would
# otherwise write a months-old kit into a target with nothing said. It warns;
# it does not stop, and it does not pull.
#
# Read-only on the clone and bounded. No ref, no object, no cache and no file
# is written: one HTTPS read of a public file, forgotten as soon as it is
# compared, and a remote that does not answer becomes a line and never a
# command that hangs in front of an install. The remote is derived from
# origin and never written down here, so a fork checks the fork and this
# clone checks this one. HEAD in the raw URL is what resolves the default
# branch, whatever the fork named it.
#
# What counts as an answer: the body's first line, digits and dots and at
# least one digit. An empty body, an error page and a rate limit answer are
# the third line, because a page taken for a number is a warn that lies
# (docs/04-Conventions.md §1). So is an origin the derivation does not cover,
# a machine with no network and a reader absent from PATH: it is the same
# failure as a network that does not answer, and it gets no wording of its
# own. The third line names a hand check rather than a command, since being
# offline has no command that fixes it.
#
# The green line says nothing newer rather than equal, because a clone ahead
# of origin is the normal state between a commit and a push and the line has
# to be true of it too.
#
# It prints and never dies, whatever the network did, and every branch ends
# in an ok or a warn: doctor goes on reporting and install goes on installing
# (docs/01-Architecture.md §6).
report_upstream() {
  local origin="" repo="" body="" answer
  origin="$(git -C "$KIT_DIR" config --get remote.origin.url 2>/dev/null || true)"
  case "$origin" in
    git@github.com:*)       repo="${origin#git@github.com:}" ;;
    ssh://git@github.com/*) repo="${origin#ssh://git@github.com/}" ;;
    https://github.com/*)   repo="${origin#https://github.com/}" ;;
    http://github.com/*)    repo="${origin#http://github.com/}" ;;
  esac
  repo="${repo%/}"
  repo="${repo%.git}"
  case "$repo" in
    */*) body="$(curl -fsSL --connect-timeout 5 --max-time 10 \
                   "https://raw.githubusercontent.com/$repo/HEAD/VERSION" 2>/dev/null)" || body="" ;;
  esac
  answer="${body%%$'\n'*}"
  case "$answer" in
    ""|*[!0-9.]*) answer="" ;;
    *[0-9]*)      ;;
    *)            answer="" ;;
  esac
  if [ -z "$answer" ]; then
    warn "kit source $KIT_VERSION, origin did not answer (check by hand: git -C $KIT_DIR pull)"
  elif [ "$answer" != "$KIT_VERSION" ] && [ "$(version_lower "$KIT_VERSION" "$answer")" = "$KIT_VERSION" ]; then
    warn "kit source $KIT_VERSION, origin has $answer (git -C $KIT_DIR pull, then focus-kit update)"
  else
    ok "kit source $KIT_VERSION (nothing newer on origin)"
  fi
}

# ---------------------------------------------------------------- repository

# The commands the kit ships, one folder name per line, read from the skills
# tree itself and never listed here: a fifth command is a folder under
# skills/ and no edit to this script, the way a fourth manual is a file under
# manuals/. Every place that enumerates the commands reads this, so the
# install, the manifest, doctor and check 4 can never disagree about which
# ones exist. The order is the glob's, which for one lowercase word each is
# alphabetical, and it is the order every line of output follows.
#
# It reads and never dies: its output is captured, and a die inside $(...)
# ends only the subshell (docs/01-Architecture.md §6).
kit_skills() {
  local d
  for d in "$KIT_DIR"/skills/*/; do
    [ -d "$d" ] || continue
    basename "$d"
  done
}

# The Ported command (docs/03-Domain.md): one skill as the reusable prompt
# GitHub Copilot reads, written to stdout. The body of the SKILL.md reaches it
# word for word and the frontmatter is carried over as it is, because its three
# keys (name, description, argument-hint) are three the prompt file format
# names; the one line added is the agent, which is what makes Copilot run the
# prompt in agent mode, and a command that writes files needs it. The Kit-owned
# banner and the License notice follow the closing --- in the source, which is
# the first position a file opening with frontmatter allows, so they arrive
# where ADR-0002 wants them without being written again here.
#
# The substitution list is below and nowhere else: one pair per thing a SKILL.md
# names that belongs to Claude Code and to no other host. A later edit to a
# skill has to respect it. What is not in it and could be: CLAUDE.md, which
# every target has whatever its host and which the host instructions file points
# at rather than replaces, and .claude/skills/initialize/templates/, which the
# skills already name by a path the install writes in every target.
#
# Pure bash, no interpreter: the file is read line by line and each line goes
# through five quoted expansions, which is bash 3.2, byte for byte the same on
# macOS, Linux and Git Bash, and never the empty answer a captured die would
# leave behind (docs/01-Architecture.md §6). It reads and never dies: its output
# is captured or piped, and the caller keeps the guard on the file.
render_prompt() { # skill
  local file="$KIT_DIR/skills/$1/SKILL.md" line n=0
  local arg_from='$ARGUMENTS'       arg_to='${input:arguments}'
  local ask_from='AskUserQuestion'  ask_to='multiple choice question'
  local new_from='/clear'           new_to='a new chat'
  local eye_from='Claude in Chrome' eye_to='The browser tool'
  local host_from='Claude Code'     host_to='GitHub Copilot'
  [ -f "$file" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    # Line 1 is the opening --- of the frontmatter, which check 4 guarantees.
    if [ "$n" -eq 1 ]; then printf '%s\n' "$line" "agent: 'agent'"; continue; fi
    line="${line//"$arg_from"/$arg_to}"
    line="${line//"$ask_from"/$ask_to}"
    line="${line//"$new_from"/$new_to}"
    line="${line//"$eye_from"/$eye_to}"
    line="${line//"$host_from"/$host_to}"
    printf '%s\n' "$line"
  done < "$file"
}

copy_tree() { # src dst  (overwrite, kit-owned)
  rm -rf "$2"
  mkdir -p "$(dirname "$2")"
  cp -R "$1" "$2"
}

# Both arguments are paths, so nothing reaches python as source: a baseline
# holding a quote, a backslash, a \uXXXX escape or the sequence ''' is data
# and never syntax. The rule, for every key the baseline holds, in this order:
#
#   a key the file lacks        the baseline's value
#   an object on both sides     the two merged key by key, by this same rule
#   a list on both sides        the file's list, then every baseline item absent
#   anything else               the baseline's value
#
# A key the baseline says nothing about is never reached, which is what makes
# the merge additive and idempotent.
merge_json() { # file  baseline, both paths
  local file="$1" baseline="$2" py
  py="$(python_bin)" || die "python3 not found (and uv is not installed to supply one)"
  mkdir -p "$(dirname "$file")"
  [ -f "$file" ] || echo '{}' > "$file"
  # The encodings are explicit because python follows the system locale
  # otherwise, and a native python on Windows reads and writes the code page
  # and ends every line with CRLF. Both files are UTF-8 with LF on every
  # platform, whoever wrote them.
  $py - "$file" "$baseline" <<'PY'
import json, sys

def merge(d, b):
    for k, v in b.items():
        if k not in d:
            d[k] = v
        elif isinstance(d[k], dict) and isinstance(v, dict):
            merge(d[k], v)
        elif isinstance(d[k], list) and isinstance(v, list):
            d[k].extend(x for x in v if x not in d[k])
        else:
            d[k] = v

path, baseline = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as f:
    d = json.load(f)
with open(baseline, encoding="utf-8") as f:
    merge(d, json.load(f))
with open(path, "w", encoding="utf-8", newline="\n") as f:
    json.dump(d, f, indent=2, ensure_ascii=False)
    f.write("\n")
PY
}

# Appended once (docs/03-Domain.md), for both files that are. The marker is
# the fragment's own first line rather than a literal here, so the test and
# the text it tests cannot drift: a fragment that changes its marker changes
# both at once. Returns 0 when it appended and 1 when the marker was already
# there, and the ok line stays with the caller, because the two callers name
# two different files. The blank line goes in only when the target file has
# something in it already.
append_once() { # file fragment
  local file="$1" fragment="$2" marker
  marker="$(head -n 1 "$fragment")"
  if grep -qF "$marker" "$file" 2>/dev/null; then
    return 1
  fi
  { [ -s "$file" ] && printf '\n'; cat "$fragment"; } >> "$file"
}

# The one place a carriage return is forgiven. A target cloned on Windows
# with core.autocrlf=true has every kit-owned file, the stamp and the
# manifest checked out as CRLF, and it receives no .gitattributes, so the
# tolerance has to live in the readers. Its seven callers are
# installed_version, fingerprint, the manifest reader inside doctor,
# global_skill_state, which reads a stamp graphify wrote on this machine, the
# two passes that read a file the target itself versions, the Fragment gap
# over .gitignore and .graphifyignore and the Manual citation over the
# target's own documents, and the read of the Manual language, which is a
# one-line file of the target's like the stamp and is printed back in the line
# the Translated manual pass writes. It
# reads and never dies: its output is captured (docs/01-Architecture.md §6),
# and the callers keep their own -f guard on the file.
without_cr() { # file
  tr -d '\r' < "$1"
}

# The Fingerprint of docs/03-Domain.md: the POSIX cksum CRC of a file read
# through without_cr, the size column dropped. cksum because POSIX specifies
# it and macOS, Linux and Git Bash all have it with no probe, which is what
# makes the manifest a Mac writes the one those three read back.
fingerprint() { # file
  without_cr "$1" | cksum | cut -d' ' -f1
}

# The Manifest: what install wrote into this target, one line per kit-owned
# file, "<crc> <path relative to the target>". doctor reads it to tell an
# edited file from a stale one, which comparing the target with the kit
# source cannot do: once the kit has moved on, every kit-owned file in a
# stale target differs from its source, and a stale target is exactly when
# someone is about to run update.
#
# The stamp and the manifest are not in it. The sort is over the whole line,
# so the order is by CRC and not by path; what matters is that it is the same
# order on every run of the same tree, which check 3 requires.
write_manifest() { # target
  local target="$1" s m f
  {
    while IFS= read -r s; do
      [ -d "$target/.claude/skills/$s" ] || continue
      (cd "$target" && find ".claude/skills/$s" -type f) | while IFS= read -r f; do
        printf '%s %s\n' "$(fingerprint "$target/$f")" "$f"
      done
    done <<< "$(kit_skills)"
    for m in "$KIT_DIR"/manuals/*.md; do
      f="docs/manuals/$(basename "$m")"
      [ -f "$target/$f" ] || continue
      printf '%s %s\n' "$(fingerprint "$target/$f")" "$f"
    done
    # The Ported commands, enumerated the way the skills they come from are, so
    # a fifth command is a folder under skills/ and no edit here. Guarded like a
    # manual: a target the generated files never reached is a target install has
    # not run in since they existed, and doctor names each one as missing.
    while IFS= read -r s; do
      f=".github/prompts/$s.prompt.md"
      [ -f "$target/$f" ] || continue
      printf '%s %s\n' "$(fingerprint "$target/$f")" "$f"
    done <<< "$(kit_skills)"
  } | LC_ALL=C sort > "$target/.claude/skills/.focus-kit-manifest"
}

install_repo() {
  local target="$1"
  [ -d "$target" ] || die "no such directory: $target"
  target="$(cd "$target" && pwd)"
  [ -d "$target/.git" ] || warn "$target is not a git repository (git init is recommended before /initialize)"

  say "installing focus-kit $KIT_VERSION into $target"

  # skills (kit-owned). The ok line names the folders it just wrote, from the
  # same enumeration, so a command the kit gained is on screen without a
  # second list to keep in step.
  local s names=""
  while IFS= read -r s; do
    copy_tree "$KIT_DIR/skills/$s" "$target/.claude/skills/$s"
    names="${names:+$names,}$s"
  done <<< "$(kit_skills)"
  printf '%s\n' "$KIT_VERSION" > "$target/.claude/skills/.focus-kit-version"
  ok ".claude/skills/{$names}"

  # manuals (kit-owned)
  mkdir -p "$target/docs/manuals"
  local m
  for m in "$KIT_DIR"/manuals/*.md; do
    cp "$m" "$target/docs/manuals/$(basename "$m")"
  done
  ok "docs/manuals/{process,focus,graphify}.md"

  # the Ported commands (kit-owned), generated from the same skills just
  # copied. Each file is overwritten and nothing else in the directory is
  # touched, the way a manual is: .github/prompts is a folder the person keeps
  # their own prompts in, and an install that emptied it would take work that
  # was never the kit's. The ok line reuses the names built above, so a fifth
  # command reaches the screen without a second list to keep in step.
  mkdir -p "$target/.github/prompts"
  while IFS= read -r s; do
    render_prompt "$s" > "$target/.github/prompts/$s.prompt.md"
  done <<< "$(kit_skills)"
  ok ".github/prompts/{$names}"

  # the manifest (kit-owned), over the files just written
  write_manifest "$target"
  ok ".claude/skills/.focus-kit-manifest"

  # work queue folder (project-owned, created only if absent)
  if [ ! -d "$target/work/done" ]; then
    mkdir -p "$target/work/done"
    touch "$target/work/done/.gitkeep"
    ok "work/done/"
  fi

  # .claude/settings.json: baseline permissions, merged (never removes what is there)
  merge_json "$target/.claude/settings.json" "$KIT_DIR/config/settings.baseline.json"
  ok ".claude/settings.json (baseline permissions merged)"

  # the two fragments, appended once each: what git does not carry, and what
  # the graph does not answer questions about
  if append_once "$target/.gitignore" "$KIT_DIR/config/gitignore.fragment"; then
    ok ".gitignore (kit fragment appended)"
  fi
  if append_once "$target/.graphifyignore" "$KIT_DIR/config/graphifyignore.fragment"; then
    ok ".graphifyignore (kit fragment appended)"
  fi

  say
  if [ -f "$target/docs/00-Product.md" ]; then
    say "docs/ already exists. Next: open Claude Code in $target and run /initialize to review it,"
    say "or go straight to /propose <slug>."
  else
    say "Next: open Claude Code in $target and run /initialize."
  fi
}

# The reader of the Installed version (docs/03-Domain.md). Every carriage
# return is removed and nothing else is trimmed: a target cloned on Windows
# with core.autocrlf=true has the stamp checked out as CRLF, and 0.5.2\r is
# not 0.5.2 to a string comparison, with the \r invisible on the terminal. It
# was the first place that needed the tolerance and is now one caller of
# without_cr, which is the only place a carriage return is forgiven.
# It reads and never dies: its output is captured, and a die inside $(...)
# ends only the subshell (docs/01-Architecture.md §6). The callers keep their
# own -f guard on the file.
installed_version() { # target
  without_cr "$1/.claude/skills/.focus-kit-version"
}

# Does this manual still have the section a citation names? The text after the
# § is compared with every heading of the manual, normalized first: the #'s and
# the "N. " numbering go, and what is left is cut at the first comma or opening
# parenthesis, so "## 5. Errors are values (ch. 8)" gives "Errors are values"
# and "## 6. Vertical slices, DRY, YAGNI, KISS, CQS" gives "Vertical slices".
# That is what lets a person cite the heading in the words the sentence needs
# instead of pasting a chapter number out of the book.
#
# A prefix and never a whole line, because a citation ends inside the sentence
# around it and nothing marks where: §Ensuring the graph is followed by a comma
# in one document, by a full stop in another and by a table pipe in a third.
#
# The pattern is a quoted variable, so a heading holding a * or a [ is text and
# not a glob. The manual is read as it is, without without_cr: it comes from
# KIT_DIR, which is a clone of this repository, whose .gitattributes checks
# every markdown file out with LF (docs/01-Architecture.md §2).
#
# It reads and never dies: its status is the whole answer
# (docs/01-Architecture.md §6).
cites_a_heading() { # manual  the text after the §
  local h
  while IFS= read -r h; do
    case "$h" in '#'*) ;; *) continue ;; esac
    while [ "${h#\#}" != "$h" ]; do h="${h#\#}"; done
    while [ "${h# }" != "$h" ]; do h="${h# }"; done
    case "$h" in [0-9]*) h="${h#*. }" ;; esac
    h="${h%%,*}"
    h="${h%%(*}"
    while [ "${h% }" != "$h" ]; do h="${h% }"; done
    [ -n "$h" ] || continue
    case "$2" in "$h"*) return 0 ;; esac
  done < "$1"
  return 1
}

doctor() {
  local target="${1:-.}"
  target="$(cd "$target" && pwd)"
  say "focus-kit $KIT_VERSION doctor: $target"
  # focus-kit update is the fix named by the two tool lines because it is the
  # command that installs both: ensure_uv and ensure_graphify run inside it.
  command -v uv >/dev/null 2>&1        && ok "uv"          || warn "uv missing (run focus-kit update)"
  command -v graphify >/dev/null 2>&1  && ok "graphify"    || warn "graphify missing (run focus-kit update)"
  # The Global skill against the package, one line per Host (kit_hosts) and
  # never a count, whatever the state. On a machine without graphify the line
  # above already says so, and every Host then reads as of unknown version,
  # which is what it is. A herestring and not a pipe, so the loop runs in this
  # shell.
  local ghost gdir gplatform gstate gskill gpackage
  while read -r gplatform gdir ghost; do
    [ -n "$gplatform" ] || continue
    read -r gstate gskill gpackage <<< "$(global_skill_state "$gdir")"
    case "$gstate" in
      equal)   ok   "graphify skill for $ghost" ;;
      missing) warn "graphify skill for $ghost missing (run focus-kit update)" ;;
      unknown) warn "graphify skill for $ghost of unknown version (run focus-kit update)" ;;
      older)   warn "graphify skill for $ghost $gskill installed, $gpackage available (run focus-kit update)" ;;
      newer)   warn "graphify skill for $ghost $gskill is newer than graphify $gpackage (uv tool upgrade graphifyy)" ;;
    esac
  done <<< "$(kit_hosts)"
  # The last line of the machine block, and the last that speaks of anything
  # but the target: whether the clone this CLI runs from is still what it was
  # cloned from (docs/03-Domain.md, Upstream version). It reports the kit
  # source (docs/01-Architecture.md §7) and not the target, and it sits above
  # every line that does, so the two are never read for each other.
  report_upstream
  # Every path reported missing below, in the form the manifest holds it. The
  # drift pass reads it to avoid saying a second time what these lines said.
  local s missing=""
  while IFS= read -r s; do
    if [ -f "$target/.claude/skills/$s/SKILL.md" ]; then
      ok "/$s"
    else
      warn "/$s missing (focus-kit update restores it)"
      missing="$missing.claude/skills/$s/SKILL.md
"
    fi
  done <<< "$(kit_skills)"
  # The Ported commands (docs/03-Domain.md), one presence line each, in the
  # shape the skills loop above prints and for the same reason: the fix is
  # update, which writes them again. Per file and not one line for the four,
  # because each path goes into $missing and the Drift pass reads it to avoid
  # naming a second time what a presence line named.
  local p
  while IFS= read -r p; do
    if [ -f "$target/.github/prompts/$p.prompt.md" ]; then
      ok ".github/prompts/$p.prompt.md"
    else
      warn ".github/prompts/$p.prompt.md missing (focus-kit update restores it)"
      missing="$missing.github/prompts/$p.prompt.md
"
    fi
  done <<< "$(kit_skills)"
  # The number, and behind it the Unbumped change (docs/03-Domain.md): a
  # target at the kit's own number whose kit-owned files are no longer what
  # the source holds. The question is asked only when the number is equal,
  # because a target stale by number already carries the one line that names
  # the fix, and only when the manifest is there, because the manifest is
  # what install wrote and the compare is against that and not against the
  # file on disk. So a file both edited locally and behind gets two lines,
  # each true. KIT_DIR is on every machine that runs doctor: the kit is
  # installed by clone and symlink, and KIT_VERSION is read from it at
  # startup.
  if [ -f "$target/.claude/skills/.focus-kit-version" ]; then
    local v; v="$(installed_version "$target")"
    if [ "$v" != "$KIT_VERSION" ]; then
      warn "kit version $v installed, $KIT_VERSION available (run focus-kit update)"
    else
      # What install would write from today's source, in the manifest's own
      # format, then the symmetric difference of the two: uniq -u keeps a
      # line that appears once, and a path appears once when its fingerprint
      # moved, when the source no longer has it, or when the source has it
      # and the manifest never did. One mechanism, the three shapes the term
      # names. The source side is enumerated the way write_manifest and
      # install_repo enumerate it, three skill folders and manuals/*.md, so
      # that behind means exactly what update would change: a .DS_Store
      # beside skills/ is never copied, and a warn naming a command that
      # would not clear it is a warn that lies (docs/04-Conventions.md §1).
      local kitmanifest="$target/.claude/skills/.focus-kit-manifest" behind="" src rel
      if [ -f "$kitmanifest" ]; then
        behind="$( { without_cr "$kitmanifest"
          while IFS= read -r src; do
            (cd "$KIT_DIR" && find "skills/$src" -type f) | while IFS= read -r rel; do
              printf '%s .claude/skills/%s\n' "$(fingerprint "$KIT_DIR/$rel")" "${rel#skills/}"
            done
          done <<< "$(kit_skills)"
          for src in "$KIT_DIR"/manuals/*.md; do
            [ -f "$src" ] || continue
            printf '%s docs/manuals/%s\n' "$(fingerprint "$src")" "$(basename "$src")"
          done
          # The Ported commands are generated and not copied, so what install
          # would write is what render_prompt prints and there is no file to
          # fingerprint. The CRC is the same one either way: the rendered text
          # through the same tr and the same cksum the manifest side used.
          while IFS= read -r src; do
            printf '%s .github/prompts/%s.prompt.md\n' \
              "$(render_prompt "$src" | tr -d '\r' | cksum | cut -d' ' -f1)" "$src"
          done <<< "$(kit_skills)"
        } | LC_ALL=C sort | uniq -u | cut -d' ' -f2- | LC_ALL=C sort -u)"
      fi
      if [ -n "$behind" ]; then
        # The warns stand in place of the green line: green means the number
        # and the content both, so it is printed only when nothing is behind.
        while IFS= read -r rel; do
          [ -n "$rel" ] || continue
          warn "$rel behind the kit source (run focus-kit update)"
        done <<< "$behind"
      else
        ok "kit version $v"
      fi
    fi
  fi
  # Two loops over the eleven paths and not one, because the fix differs: the
  # eight project-owned files are what /initialize writes, and the three
  # manuals are kit-owned, so their line carries the drift wording verbatim.
  # The order of the output is the order of the single loop these two replace.
  # Both feed $missing, as the one loop did: the drift pass reads it to avoid
  # naming a second time what a presence line named.
  local f
  for f in docs/00-Product.md docs/01-Architecture.md docs/02-Backend.md docs/03-Domain.md \
           docs/04-Conventions.md docs/05-Process.md docs/06-Queue.md CLAUDE.md; do
    if [ -f "$target/$f" ]; then
      ok "$f"
    else
      warn "$f missing (run /initialize)"
      missing="$missing$f
"
    fi
  done
  for f in docs/manuals/process.md docs/manuals/focus.md docs/manuals/graphify.md; do
    if [ -f "$target/$f" ]; then
      ok "$f"
    else
      warn "$f missing (focus-kit update restores it)"
      missing="$missing$f
"
    fi
  done
  # The Manual language (docs/03-Domain.md), read once for the two passes that
  # ask it: the Translated manual pass right below and the Drift pass further
  # down, which skips the three manuals where the answer is not en. /initialize
  # writes this file and the CLI only reads it. Absent means en, which is every
  # target installed before it existed, and is what keeps all of them printing
  # what they printed. Through without_cr, its seventh caller: the target
  # versions this file, receives no .gitattributes, and the tag is quoted back
  # in every line the pass writes.
  local mlang="en"
  if [ -f "$target/.claude/skills/.focus-kit-language" ]; then
    mlang="$(without_cr "$target/.claude/skills/.focus-kit-language")"
  fi
  # Translated manual (docs/03-Domain.md): where the target's manuals are meant
  # to be in another language, each one that is still the English file the kit
  # ships. One warn per manual and never a count, the way the Fragment gap and
  # the Manual citation passes print one line per thing to fix, so a target with
  # two translated manuals and one English names the one. Still English means
  # equal by fingerprint to the source at KIT_DIR, which reuses the function and
  # with it the without_cr tolerance: a Windows target with core.autocrlf=true
  # holds the untranslated manual as CRLF against the kit's LF, and a byte
  # comparison would call it translated. Against KIT_DIR and not against the
  # manifest, because the manifest answers whether a file was edited and this
  # pass asks whether a translation ever happened.
  #
  # The manuals are enumerated as manuals/*.md from KIT_DIR, the way every other
  # read of the kit's own files is, so a fourth manual is a file and no edit. A
  # manual the target does not have is skipped: the presence lines above already
  # said so, and the question here is asked of the ones that are there.
  if [ "$mlang" != "en" ]; then
    local mfile mrel english=0
    for mfile in "$KIT_DIR"/manuals/*.md; do
      mrel="docs/manuals/$(basename "$mfile")"
      [ -f "$target/$mrel" ] || continue
      [ "$(fingerprint "$target/$mrel")" = "$(fingerprint "$mfile")" ] || continue
      warn "$mrel in English, not $mlang (run /initialize to translate it)"
      english=1
    done
    [ "$english" -eq 1 ] || ok "docs/manuals ($mlang)"
  fi
  # The one Merged file (docs/03-Domain.md), read back for what its baseline
  # put there. Presence is not the question: a .claude/settings.json that reads
  # {} exists and still leaves every permission unasked for. Its path does not
  # go into $missing: a merged file is not in the manifest, so the drift pass
  # has nothing to say about it twice.
  #
  # A fixed-string grep behind an -f guard, because grep on an absent file
  # exits 2 and prints, and a grep and not python, because the failure to
  # catch is python missing: that is the choice check 2 of selftest made and
  # the reason is the same one. The string is a heuristic, it cannot see under
  # which key the permission sits, and that is accepted. No without_cr: a
  # carriage return at the end of a line does not touch a substring inside it.
  if [ ! -f "$target/.claude/settings.json" ]; then
    warn ".claude/settings.json missing (run focus-kit update)"
  elif ! grep -qF -- '"Bash(graphify *)"' "$target/.claude/settings.json"; then
    warn ".claude/settings.json lacks the baseline permissions (run focus-kit update)"
  else
    ok ".claude/settings.json"
  fi
  # Leftover (docs/03-Domain.md): what an earlier kit merged and this one no
  # longer ships. Merged is additive, so update leaves both entries where they
  # are and only a person removes them; doctor names the removal and the
  # section that explains it. Same -f guard and same fixed-string heuristic as
  # the block above, for the same reasons. The quotes stay inside the pattern:
  # a bare graphify would match the "Bash(graphify *)" permission every target
  # has.
  if [ -f "$target/.mcp.json" ] && grep -qF -- '"graphify-mcp"' "$target/.mcp.json"; then
    warn ".mcp.json still declares the graphify server (remove its graphify entry by hand; docs/manuals/graphify.md §Troubleshooting)"
  fi
  if [ -f "$target/.claude/settings.json" ] &&
     grep -qF -- '"enabledMcpjsonServers"' "$target/.claude/settings.json" &&
     grep -qF -- '"graphify"' "$target/.claude/settings.json"; then
    warn ".claude/settings.json still enables the graphify server (remove graphify from enabledMcpjsonServers by hand; docs/manuals/graphify.md §Troubleshooting)"
  fi
  # Fragment gap (docs/03-Domain.md): what a target's Appended once file lacks
  # of the fragment the kit ships now. append_once writes the block the first
  # time and never again, so a target installed before a line joined a fragment
  # never receives it, and update leaves the block where it is rather than
  # re-adding a line the person may have removed on purpose. The two pairs are
  # the two appends of install_repo, in the order it appends them.
  #
  # What is looked for is a pattern line: a line of the fragment that is
  # neither blank nor beginning with #. The marker and the comments around it
  # carry no behaviour, and the marker's own presence is what append_once
  # already tests, with the same fixed-string grep, so the two agree on what a
  # block being there means.
  #
  # Present means a whole line and never a substring: an old target holds
  # graphify-out/cost.json and lacks graphify-out/, and a substring test would
  # go green on exactly the case this pass exists for. The target's file is
  # read through without_cr, its fifth caller, because the target's own
  # .gitignore is checked out CRLF on a Windows clone and receives no
  # .gitattributes from the kit.
  local pair pfile pfrag marker gap pline
  for pair in ".gitignore gitignore.fragment" ".graphifyignore graphifyignore.fragment"; do
    read -r pfile pfrag <<< "$pair"
    marker="$(head -n 1 "$KIT_DIR/config/$pfrag")"
    if [ ! -f "$target/$pfile" ] || ! grep -qF -- "$marker" "$target/$pfile"; then
      warn "$pfile has no focus-kit block (run focus-kit update)"
      continue
    fi
    # A herestring and not a pipe: a pipe would run the loop in a subshell and
    # gap would come back 0 however many lines it warned about.
    gap=0
    while IFS= read -r pline; do
      case "$pline" in ''|'#'*) continue ;; esac
      without_cr "$target/$pfile" | grep -qxF -- "$pline" && continue
      warn "$pfile lacks the kit's line \"$pline\" (add it by hand; focus-kit update leaves an existing block alone)"
      gap=1
    done <<< "$(cat "$KIT_DIR/config/$pfrag")"
    [ "$gap" -eq 1 ] || ok "$pfile (kit fragment current)"
  done
  # Drift (docs/03-Domain.md): a kit-owned file that is not as install wrote
  # it. The question is only asked of a target that has a stamp, because a
  # target with no stamp has no kit in it. A file that is absent is drift
  # too, although update restores it: the manifest is the only complete list
  # of kit-owned files a target holds, so a green line that skipped an entry
  # was never earned. A path the presence lines above already named is not
  # repeated here, and the rule is by position in the output, not a list of
  # paths.
  if [ -f "$target/.claude/skills/.focus-kit-version" ]; then
    local manifest="$target/.claude/skills/.focus-kit-manifest"
    if [ ! -f "$manifest" ]; then
      warn ".claude/skills/.focus-kit-manifest missing: cannot tell whether a kit-owned file was edited locally (run focus-kit update)"
    else
      local lines listed drift=0 crc path d
      # Read through without_cr, or a CRLF checkout of the manifest itself
      # gives every path a trailing byte that matches no file on disk.
      lines="$(without_cr "$manifest")"
      listed="$(printf '%s\n' "$lines" | cut -d' ' -f2-)"
      # A herestring and not a pipe: a pipe would run the loop in a subshell
      # and drift would come back 0 however many lines were printed.
      while read -r crc path; do
        [ -n "$path" ] || continue
        if [ ! -f "$target/$path" ]; then
          drift=1
          printf '%s\n' "$missing" | grep -qxF -- "$path" ||
            warn "$path missing (focus-kit update restores it)"
          continue
        fi
        # The one exception, and it is the Manual language's: where the target's
        # manuals are meant to be in another language, the manifest holds the
        # fingerprint of the English file install wrote and the disk holds the
        # translation, so the comparison would call all three edited locally.
        # What is asked of them instead is the pass above. Everything else the
        # manifest names is compared as it always was, and a manual that is
        # absent is still the missing shape, which the line above prints.
        if [ "$mlang" != "en" ]; then
          case "$path" in docs/manuals/*) continue ;; esac
        fi
        if [ "$(fingerprint "$target/$path")" != "$crc" ]; then
          warn "$path edited locally (focus-kit update overwrites it)"
          drift=1
        fi
      done <<< "$lines"
      # A file added inside a kit skill is as lost as an edit: copy_tree is
      # rm -rf then cp -R. Each folder is guarded, so a target with /propose
      # missing gets no find error in the middle of doctor.
      while IFS= read -r d; do
        [ -d "$target/.claude/skills/$d" ] || continue
        while IFS= read -r path; do
          [ -n "$path" ] || continue
          printf '%s\n' "$listed" | grep -qxF -- "$path" && continue
          warn "$path is not the kit's (focus-kit update removes it)"
          drift=1
        done <<< "$(cd "$target" && find ".claude/skills/$d" -type f)"
      done <<< "$(kit_skills)"
      [ "$drift" -eq 1 ] || ok "kit-owned files as install wrote them"
    fi
  fi
  # Manual citation (docs/03-Domain.md): a reference from one of the documents
  # this target reads again and again to a section of a kit-owned Manual, at an
  # address the next update can move under it. update overwrites the manual and
  # never the citing document, so a section inserted in a manual renumbers every
  # one below it and a citation by number goes on pointing at a number that now
  # means something else. Both fixes are a hand edit: the citing file is the
  # target's own, which ADR-0002 forbids the CLI, and what the citation meant is
  # only in the sentence around it.
  #
  # The manuals are the ones the kit ships, read from KIT_DIR as manuals/*.md
  # the way every other read of the kit's own files is, so a fourth manual is a
  # file and no edit here. Against the kit's copy and never the target's,
  # because what is at stake is what the next update writes.
  #
  # The documents are CLAUDE.md, docs/00 to 06 and everything under docs/adr/.
  # work/ is not read, in flight or done: a Delivery is read by the one session
  # that builds it, and a Done page records what was, which a correction would
  # falsify.
  #
  # Each file is read through without_cr, its sixth caller and the second over
  # a file the target itself versions: a Windows clone checks these out with a
  # carriage return, and the warn quotes the rest of the line.
  local cdocs cdoc n rest before after key name cited=0
  cdocs="CLAUDE.md
docs/00-Product.md
docs/01-Architecture.md
docs/02-Backend.md
docs/03-Domain.md
docs/04-Conventions.md
docs/05-Process.md
docs/06-Queue.md"
  if [ -d "$target/docs/adr" ]; then
    cdocs="$cdocs
$(cd "$target" && find docs/adr -type f | LC_ALL=C sort)"
  fi
  # Herestrings and not pipes, the two of them: a pipe would run the loop in a
  # subshell and cited would come back 0 however many lines it warned about.
  while IFS= read -r cdoc; do
    [ -n "$cdoc" ] || continue
    [ -f "$target/$cdoc" ] || continue
    n=0
    while IFS= read -r rest; do
      n=$((n + 1))
      # One line may carry two citations, so the scan walks the § signs rather
      # than stopping at the first.
      while :; do
        case "$rest" in *§*) ;; *) break ;; esac
        before="${rest%%§*}"
        after="${rest#*§}"
        rest="$after"
        # What sits in front of the § is a citation only when it ends in the
        # name of a manual the kit ships, with nothing between the two but
        # backticks and spaces. manuals/ is part of the key: a target's own
        # docs/05-Process.md is one file name away from process.md, and every
        # citation the kit and its targets write carries the folder.
        key="$before"
        while :; do
          case "$key" in
            *' ')  key="${key% }" ;;
            *'`')  key="${key%\`}" ;;
            *)     break ;;
          esac
        done
        case "$key" in *manuals/*.md) ;; *) continue ;; esac
        name="${key##*manuals/}"
        [ -f "$KIT_DIR/manuals/$name" ] || continue
        # By number when a digit follows the §, by heading otherwise, and the
        # heading then runs to the end of the line.
        case "$after" in
          [0-9]*)
            warn "$cdoc:$n cites docs/manuals/$name by number: \"§$after\" (cite the heading by hand; a section added to that manual renumbers the ones below it)"
            cited=1
            continue ;;
        esac
        cites_a_heading "$KIT_DIR/manuals/$name" "$after" && continue
        warn "$cdoc:$n cites a section docs/manuals/$name does not have: \"§$after\" (fix the citation by hand; the heading moved or was renamed)"
        cited=1
      done
    done <<< "$(without_cr "$target/$cdoc")"
  done <<< "$cdocs"
  # Green on a target whose every citation names a heading the manual has, and
  # green on a target /initialize never ran in: nothing there points at a
  # section that can move.
  [ "$cited" -eq 1 ] || ok "project-owned documents (every manual citation by heading, every heading there)"
  [ -f "$target/graphify-out/graph.json" ] && ok "graphify-out/graph.json" || warn "graphify-out/graph.json missing (/propose and /apply rebuild it; docs/manuals/graphify.md)"
  if [ -d "$target/.git" ]; then
    if (cd "$target" && graphify hook status 2>/dev/null | grep -i '^post-commit' | grep -qiv 'not installed'); then
      ok "graphify post-commit hook"
    else
      warn "graphify post-commit hook not installed (graphify hook install)"
    fi
  fi
}

# ---------------------------------------------------------------- selftest

# The six checks of docs/05-Process.md §4, in order, stopping at the first
# red. They always run against KIT_DIR and take no path: four of them are
# about the kit's own sources, and a target never receives bin/focus-kit.

SELFTEST_DIR=""
selftest_cleanup() { [ -z "$SELFTEST_DIR" ] || rm -rf "$SELFTEST_DIR"; }

check_parses() {
  local out
  out="$(bash -n "$KIT_DIR/bin/focus-kit" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 1: bin/focus-kit does not parse"
  }
  ok "1 bin/focus-kit parses"
}

check_install() { # scratch
  local scratch="$1" out expected line
  git init -q "$scratch" >/dev/null 2>&1 || die "check 2: git init failed in $scratch"
  out="$(install_repo "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: the install into the scratch repository failed"
  }
  out="$(doctor "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: doctor failed in the scratch repository"
  }
  # The expected line is built by calling ok, so the assertion and the
  # reporter cannot drift. The command names stay literal here, where every
  # other place in the script enumerates the skills tree: an assertion that
  # read the same list as the reporter would assert nothing, which is why
  # each manual is written out here too. A new command joins this list.
  for expected in /apply /discuss /initialize /propose \
                  .github/prompts/apply.prompt.md .github/prompts/discuss.prompt.md \
                  .github/prompts/initialize.prompt.md .github/prompts/propose.prompt.md \
                  docs/manuals/process.md docs/manuals/focus.md \
                  docs/manuals/graphify.md .claude/settings.json \
                  ".gitignore (kit fragment current)" \
                  ".graphifyignore (kit fragment current)" \
                  "kit version $KIT_VERSION" \
                  "kit-owned files as install wrote them" \
                  "project-owned documents (every manual citation by heading, every heading there)"; do
    line="$(ok "$expected")"
    printf '%s\n' "$out" | grep -qF -- "$line" || {
      printf '%s\n' "$out"
      die "check 2: doctor did not report $expected in the scratch repository"
    }
  done
  # The ten warns of the same run. A scratch repository has not had
  # /initialize run in it, so these are the expected output and not a failure,
  # and each one has to name the command that puts it right
  # (docs/04-Conventions.md §1). Asserted through warn, as the green lines are
  # through ok: a parenthesis edited in doctor and not here turns check 2 red.
  for expected in "docs/00-Product.md missing (run /initialize)" \
                  "docs/01-Architecture.md missing (run /initialize)" \
                  "docs/02-Backend.md missing (run /initialize)" \
                  "docs/03-Domain.md missing (run /initialize)" \
                  "docs/04-Conventions.md missing (run /initialize)" \
                  "docs/05-Process.md missing (run /initialize)" \
                  "docs/06-Queue.md missing (run /initialize)" \
                  "CLAUDE.md missing (run /initialize)" \
                  "graphify-out/graph.json missing (/propose and /apply rebuild it; docs/manuals/graphify.md)" \
                  "graphify post-commit hook not installed (graphify hook install)"; do
    line="$(warn "$expected")"
    printf '%s\n' "$out" | grep -qF -- "$line" || {
      printf '%s\n' "$out"
      die "check 2: doctor did not report $expected in the scratch repository"
    }
  done
  # What the install did not write. Absence is what mcp-leaves-the-baseline
  # ships, and a green doctor cannot say it: no line names a file the kit
  # stopped touching, so the two assertions are made here, against the tree.
  [ ! -e "$scratch/.mcp.json" ] || \
    die "check 2: the install wrote .mcp.json into the scratch repository"
  if grep -qF -- '"enabledMcpjsonServers"' "$scratch/.claude/settings.json"; then
    printf '%s\n' "$(cat "$scratch/.claude/settings.json")"
    die "check 2: the settings baseline put enabledMcpjsonServers into the scratch repository"
  fi
  # What the JSON merge wrote is asserted through doctor and not read here:
  # the green line above already says the merged file carries what its baseline
  # put there, and this probe proves the other branch. The file is moved aside
  # and rewritten as {}, which is what a target holds when the merge never ran.
  # The move back is byte-exact, because check 3 snapshots this scratch next;
  # the file waits beside it, as the fake home does, and the trap removes
  # whatever a red left there.
  mv "$scratch/.claude/settings.json" "$SELFTEST_DIR/settings.json.aside"
  printf '%s\n' '{}' > "$scratch/.claude/settings.json"
  out="$(doctor "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: doctor failed in the scratch repository"
  }
  mv "$SELFTEST_DIR/settings.json.aside" "$scratch/.claude/settings.json"
  line="$(warn ".claude/settings.json lacks the baseline permissions (run focus-kit update)")"
  printf '%s\n' "$out" | grep -qF -- "$line" || {
    printf '%s\n' "$out"
    die "check 2: doctor did not report a settings file without the baseline permissions in the scratch repository"
  }
  # The Leftover pass (docs/03-Domain.md), against the shape an earlier kit
  # left behind: an .mcp.json declaring the server and a settings file
  # enabling it. One doctor run has to name both, each with the hand removal,
  # because update never takes either away. The .mcp.json is removed and not
  # moved back, since the install never wrote one; the settings file goes
  # aside and returns byte-exact, for check 3.
  mv "$scratch/.claude/settings.json" "$SELFTEST_DIR/settings.json.aside"
  cat > "$scratch/.mcp.json" <<'JSON'
{
  "mcpServers": {
    "graphify": {
      "command": "graphify-mcp",
      "args": ["graphify-out/graph.json"]
    }
  }
}
JSON
  cat > "$scratch/.claude/settings.json" <<'JSON'
{
  "enabledMcpjsonServers": [
    "graphify"
  ]
}
JSON
  out="$(doctor "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: doctor failed in the scratch repository"
  }
  rm -f "$scratch/.mcp.json"
  mv "$SELFTEST_DIR/settings.json.aside" "$scratch/.claude/settings.json"
  for expected in ".mcp.json still declares the graphify server (remove its graphify entry by hand; docs/manuals/graphify.md §Troubleshooting)" \
                  ".claude/settings.json still enables the graphify server (remove graphify from enabledMcpjsonServers by hand; docs/manuals/graphify.md §Troubleshooting)"; do
    line="$(warn "$expected")"
    printf '%s\n' "$out" | grep -qF -- "$line" || {
      printf '%s\n' "$out"
      die "check 2: doctor did not report $expected in the scratch repository"
    }
  done
  # The Fragment gap pass (docs/03-Domain.md), one probe per file, because one
  # would prove the pass over one pair where the loop runs over two. Both files
  # are the target's own and neither is in the manifest, so no restore has to
  # agree with it; each one still goes aside and comes back byte for byte,
  # because check 3 installs into this same scratch and compares the trees.
  #
  # First the target installed before graph-rebuilds-on-demand: the block is
  # there and one of its pattern lines is not. The run has to name that line
  # and must not print the green line, which is the only assertion that
  # separates a whole-line test from the substring one: graphify-out/cost.json
  # is not in a scratch, but the green line on a file missing a line would be
  # the same defect wherever it came from.
  mv "$scratch/.gitignore" "$SELFTEST_DIR/gitignore.aside"
  grep -vxF -- 'graphify-out/' "$SELFTEST_DIR/gitignore.aside" > "$scratch/.gitignore"
  out="$(doctor "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: doctor failed in the scratch repository"
  }
  mv "$SELFTEST_DIR/gitignore.aside" "$scratch/.gitignore"
  line="$(warn ".gitignore lacks the kit's line \"graphify-out/\" (add it by hand; focus-kit update leaves an existing block alone)")"
  printf '%s\n' "$out" | grep -qF -- "$line" || {
    printf '%s\n' "$out"
    die "check 2: doctor did not name the kit line cut out of the scratch repository's .gitignore"
  }
  line="$(ok ".gitignore (kit fragment current)")"
  if printf '%s\n' "$out" | grep -qF -- "$line"; then
    printf '%s\n' "$out"
    die "check 2: doctor called a .gitignore current with one line of the kit fragment cut out of it"
  fi
  # Then the other file and the other state: the whole block gone, which is a
  # target that predates the fragment as much as it is one whose block a person
  # removed. The fix is the command and not a paste, and doctor cannot tell the
  # two apart, so one wording covers both.
  mv "$scratch/.graphifyignore" "$SELFTEST_DIR/graphifyignore.aside"
  : > "$scratch/.graphifyignore"
  out="$(doctor "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: doctor failed in the scratch repository"
  }
  mv "$SELFTEST_DIR/graphifyignore.aside" "$scratch/.graphifyignore"
  line="$(warn ".graphifyignore has no focus-kit block (run focus-kit update)")"
  printf '%s\n' "$out" | grep -qF -- "$line" || {
    printf '%s\n' "$out"
    die "check 2: doctor did not report a .graphifyignore with the kit block cut out of it in the scratch repository"
  }
  # The stamp as a Windows clone with core.autocrlf=true checks it out. The
  # probe runs on every platform because nothing on macOS or Linux ever writes
  # that byte: without it, a regression in installed_version would be
  # invisible on the two platforms the kit is developed on, and this defect
  # actually happened.
  printf '%s\r\n' "$KIT_VERSION" > "$scratch/.claude/skills/.focus-kit-version"
  line="$(ok "kit version $KIT_VERSION")"
  if ! out="$(doctor "$scratch" 2>&1)" || ! printf '%s\n' "$out" | grep -qF -- "$line"; then
    printf '%s\n' "$out"
    die "check 2: doctor did not tolerate a CRLF .focus-kit-version in the scratch repository (a Windows clone with core.autocrlf=true writes one)"
  fi
  # Restored to the byte-exact line install_repo writes: check 3 snapshots
  # this scratch and installs into it again, and a CRLF stamp left behind
  # would come back as a false idempotency failure.
  printf '%s\n' "$KIT_VERSION" > "$scratch/.claude/skills/.focus-kit-version"
  # The four drift probes, on the same scratch, each restored before check 3
  # snapshots it. First the whole Windows checkout: a manual and the manifest
  # itself with CRLF line ends. doctor must still report no drift, which it
  # does only while both the fingerprint and the manifest reader go through
  # without_cr; keep the byte in either one and a Windows target reads as
  # entirely edited.
  local manual="$scratch/docs/manuals/focus.md"
  local manifest="$scratch/.claude/skills/.focus-kit-manifest"
  awk '{ printf "%s\r\n", $0 }' "$manual"   > "$manual.crlf"   && mv "$manual.crlf" "$manual"
  awk '{ printf "%s\r\n", $0 }' "$manifest" > "$manifest.crlf" && mv "$manifest.crlf" "$manifest"
  line="$(ok "kit-owned files as install wrote them")"
  if ! out="$(doctor "$scratch" 2>&1)" || ! printf '%s\n' "$out" | grep -qF -- "$line"; then
    printf '%s\n' "$out"
    die "check 2: doctor reported drift on a CRLF checkout of the scratch repository (a Windows clone with core.autocrlf=true writes one)"
  fi
  # Then the two kinds of drift, in one doctor run: a kit-owned file edited
  # in place and a file added inside a kit skill. Both are erased by the next
  # update, and the point of the command is to say so before it happens.
  printf '%s\n' "A line a person added to their copy of the manual." >> "$manual"
  printf '%s\n' "A file a person added inside a kit skill." > "$scratch/.claude/skills/apply/extra.md"
  out="$(doctor "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: doctor failed in the scratch repository"
  }
  line="$(warn "docs/manuals/focus.md edited locally (focus-kit update overwrites it)")"
  printf '%s\n' "$out" | grep -qF -- "$line" || {
    printf '%s\n' "$out"
    die "check 2: doctor did not report an edited manual in the scratch repository"
  }
  line="$(warn ".claude/skills/apply/extra.md is not the kit's (focus-kit update removes it)")"
  printf '%s\n' "$out" | grep -qF -- "$line" || {
    printf '%s\n' "$out"
    die "check 2: doctor did not report a file added to a kit skill in the scratch repository"
  }
  # Restored, manifest included: write_manifest is deterministic over the
  # same tree, so what it writes here is byte for byte what the install
  # wrote, and check 3 sees the tree it would have seen.
  cp "$KIT_DIR/manuals/focus.md" "$manual"
  rm -f "$scratch/.claude/skills/apply/extra.md"
  write_manifest "$scratch"
  # The fourth kind of drift: a kit-owned file the target no longer has. A
  # template, because ten of the seventeen paths the manifest names are
  # templates and no presence line anywhere covers them, so this is the only
  # place the deletion can be caught. Both assertions in one doctor run: the
  # warn has to be there and the green line has not to be.
  local template=".claude/skills/initialize/templates/CLAUDE.md"
  rm "$scratch/$template"
  out="$(doctor "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: doctor failed in the scratch repository"
  }
  line="$(warn "$template missing (focus-kit update restores it)")"
  printf '%s\n' "$out" | grep -qF -- "$line" || {
    printf '%s\n' "$out"
    die "check 2: doctor did not report a kit-owned file deleted from the scratch repository"
  }
  # An if and not an && list: under set -e an && list whose last command
  # fails ends the script, and here the grep failing is the green case.
  line="$(ok "kit-owned files as install wrote them")"
  if printf '%s\n' "$out" | grep -qF -- "$line"; then
    printf '%s\n' "$out"
    die "check 2: doctor printed the drift ok line with a kit-owned file deleted from the scratch repository"
  fi
  # Restored by copy alone: a deletion does not change the manifest, so the
  # one write_manifest above still describes this tree byte for byte.
  cp "$KIT_DIR/skills/initialize/templates/CLAUDE.md" "$scratch/$template"
  # A kit-owned file a presence line does name: a manual. Its presence line
  # and the drift pass would say the same thing about the same path, and the
  # drift pass stays silent because $missing holds it. The two say the same
  # thing word for word, so counting is the only way to prove there is one of
  # them: a count, not a grep -q. The green drift line is still forbidden,
  # exactly as for the template.
  local manualpath="docs/manuals/process.md"
  rm "$scratch/$manualpath"
  out="$(doctor "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: doctor failed in the scratch repository"
  }
  line="$(warn "$manualpath missing (focus-kit update restores it)")"
  # The substitution inside the test and not in an assignment: grep -c exits 1
  # on a count of zero, and under set -e a failing assignment ends the script
  # before the die that explains it.
  if [ "$(printf '%s\n' "$out" | grep -cF -- "$line")" -ne 1 ]; then
    printf '%s\n' "$out"
    die "check 2: doctor did not report a deleted manual exactly once in the scratch repository"
  fi
  line="$(ok "kit-owned files as install wrote them")"
  if printf '%s\n' "$out" | grep -qF -- "$line"; then
    printf '%s\n' "$out"
    die "check 2: doctor printed the drift ok line with a manual deleted from the scratch repository"
  fi
  # Restored by copy alone, as the template above and for the same reason.
  cp "$KIT_DIR/manuals/process.md" "$scratch/$manualpath"
  # The Unbumped change (docs/03-Domain.md), the three shapes in one doctor
  # run. The constraint is that the scratch and its manifest agree with each
  # other and not with the source, without a byte of the kit source touched:
  # the manual is edited and write_manifest is run over the result, so the
  # manifest records the edit; a file listed in the manifest and absent from
  # the source is a file created here and recorded the same way; and a source
  # file the manifest never listed is one line cut out of the manifest.
  printf '%s\n' "A line the kit source does not have." >> "$manual"
  printf '%s\n' "A file the kit source does not have." > "$scratch/.claude/skills/apply/ghost.md"
  write_manifest "$scratch"
  grep -v ' docs/manuals/graphify.md$' "$manifest" > "$manifest.cut"
  mv "$manifest.cut" "$manifest"
  out="$(doctor "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: doctor failed in the scratch repository"
  }
  # Restored before the assertions, so a red leaves the tree as check 3 needs
  # it. write_manifest is deterministic over the same tree, so what it writes
  # here is byte for byte what the install wrote.
  cp "$KIT_DIR/manuals/focus.md" "$manual"
  rm -f "$scratch/.claude/skills/apply/ghost.md"
  write_manifest "$scratch"
  for expected in "docs/manuals/focus.md behind the kit source (run focus-kit update)" \
                  ".claude/skills/apply/ghost.md behind the kit source (run focus-kit update)" \
                  "docs/manuals/graphify.md behind the kit source (run focus-kit update)"; do
    line="$(warn "$expected")"
    printf '%s\n' "$out" | grep -qF -- "$line" || {
      printf '%s\n' "$out"
      die "check 2: doctor did not report $expected in the scratch repository"
    }
  done
  # The green version line stands down while a file is behind: green means the
  # number and the content both. An if and not an && list, because here the
  # grep failing is the green case (line 716 above, same reason).
  line="$(ok "kit version $KIT_VERSION")"
  if printf '%s\n' "$out" | grep -qF -- "$line"; then
    printf '%s\n' "$out"
    die "check 2: doctor printed the green version line with a kit-owned file behind the kit source"
  fi
  # And the two negatives that say the compare is against the manifest and not
  # against the file on disk: the manual was edited, and because the manifest
  # records the edit it is behind and not drift, so the drift pass stays green.
  line="$(warn "docs/manuals/focus.md edited locally (focus-kit update overwrites it)")"
  if printf '%s\n' "$out" | grep -qF -- "$line"; then
    printf '%s\n' "$out"
    die "check 2: doctor called a file its own manifest agrees with edited locally"
  fi
  line="$(ok "kit-owned files as install wrote them")"
  printf '%s\n' "$out" | grep -qF -- "$line" || {
    printf '%s\n' "$out"
    die "check 2: doctor reported drift on a scratch repository that only its source had moved past"
  }
  # The Manual citation pass (docs/03-Domain.md), on one project-owned document
  # written into the scratch for it. The green line above already proves the
  # other branch, on a scratch that cites nothing, which is also the target
  # /initialize never ran in. Here the two warns, in one doctor run: a citation
  # by number and a citation by a heading no manual has. The line numbers are
  # the check's own, so the <path>:<line> of each warn is asserted exactly.
  #
  # CLAUDE.md and not a file under docs/, because it leaves no directory behind
  # when it goes, and it goes: it is project-owned, and check 3 installs into
  # this same scratch.
  local claude="$scratch/CLAUDE.md"
  cat > "$claude" <<'MD'
A scratch document, for the probe below.
It cites `docs/manuals/process.md` §7, which is a number.
And `docs/manuals/focus.md` §A heading no manual ships.
MD
  out="$(doctor "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: doctor failed in the scratch repository"
  }
  for expected in "CLAUDE.md:2 cites docs/manuals/process.md by number: \"§7, which is a number.\" (cite the heading by hand; a section added to that manual renumbers the ones below it)" \
                  "CLAUDE.md:3 cites a section docs/manuals/focus.md does not have: \"§A heading no manual ships.\" (fix the citation by hand; the heading moved or was renamed)"; do
    line="$(warn "$expected")"
    printf '%s\n' "$out" | grep -qF -- "$line" || {
      printf '%s\n' "$out"
      die "check 2: doctor did not report $expected in the scratch repository"
    }
  done
  # An if and not an && list, because here the grep failing is the green case.
  line="$(ok "project-owned documents (every manual citation by heading, every heading there)")"
  if printf '%s\n' "$out" | grep -qF -- "$line"; then
    printf '%s\n' "$out"
    die "check 2: doctor called the scratch repository's documents current with a citation by number in one of them"
  fi
  # Then the same document with one citation by a heading the manual has, which
  # is the state every target is meant to be in.
  cat > "$claude" <<'MD'
A scratch document, for the probe below.
It cites `docs/manuals/process.md` §The house rules, by heading.
MD
  out="$(doctor "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 2: doctor failed in the scratch repository"
  }
  rm -f "$claude"
  printf '%s\n' "$out" | grep -qF -- "$line" || {
    printf '%s\n' "$out"
    die "check 2: doctor did not call the scratch repository's documents current with every citation by heading"
  }
  # The Global skill (docs/03-Domain.md), four doctor runs against a fake home
  # and a fake graphify on PATH: every line the state table can print, for
  # every Host, on any machine, with no network, without graphify and without
  # touching the real ~/.claude or ~/.copilot. Both fakes live beside the
  # scratch and not in it, because check 3 snapshots the scratch, and the trap
  # that removes SELFTEST_DIR removes them. Each run is a command
  # substitution, so the two assignments in front of doctor die with the
  # subshell instead of outliving the call.
  #
  # The fake home holds one skill directory per Host and the two host names
  # are written out here, the way the four command names are and for the same
  # reason: an assertion that read kit_hosts would read the reporter's own
  # list and assert nothing (docs/05-Process.md §4). The fake graphify needs
  # no widening, since it only ever answers --version: ensure_graphify is the
  # one caller of the installer and check 2 never runs it.
  local home="$SELFTEST_DIR/home" bin="$SELFTEST_DIR/bin" expected
  mkdir -p "$home/.claude/skills/graphify" "$home/.copilot/skills/graphify" "$bin"
  printf '%s\n' "A fake global skill, for the probe below." > "$home/.claude/skills/graphify/SKILL.md"
  printf '%s\n' "A fake global skill, for the probe below." > "$home/.copilot/skills/graphify/SKILL.md"
  printf '%s\n' '#!/bin/sh' 'echo "graphify 9.9.9"' > "$bin/graphify"
  chmod +x "$bin/graphify"
  # 9.9.10 first: it is the run that proves the order is numeric, because a
  # string comparison puts 9.9.10 before 9.9.9 and calls the newer skill older.
  # "-" is no stamp at all. Each expected line is built through ok or warn, as
  # every other assertion here is, so the check and the reporter cannot drift.
  local v d h
  for v in 9.9.10 9.9.8 - 9.9.9; do
    for d in .claude .copilot; do
      if [ "$v" = "-" ]; then rm -f "$home/$d/skills/graphify/.graphify_version"
      else printf '%s\n' "$v" > "$home/$d/skills/graphify/.graphify_version"; fi
    done
    out="$(HOME="$home" PATH="$bin:$PATH" doctor "$scratch" 2>&1)" || {
      printf '%s\n' "$out"
      die "check 2: doctor failed against the fake home with the skill stamp at $v"
    }
    for h in "Claude Code" "GitHub Copilot"; do
      case "$v" in
        9.9.10) expected="$(warn "graphify skill for $h 9.9.10 is newer than graphify 9.9.9 (uv tool upgrade graphifyy)")" ;;
        9.9.8)  expected="$(warn "graphify skill for $h 9.9.8 installed, 9.9.9 available (run focus-kit update)")" ;;
        -)      expected="$(warn "graphify skill for $h of unknown version (run focus-kit update)")" ;;
        9.9.9)  expected="$(ok "graphify skill for $h")" ;;
      esac
      printf '%s\n' "$out" | grep -qF -- "$expected" || {
        printf '%s\n' "$out"
        die "check 2: doctor did not report the graphify skill for $h as expected with the stamp at $v and graphify at 9.9.9"
      }
    done
  done
  # The Upstream version (docs/03-Domain.md), four doctor runs against the
  # fake reader selftest put on PATH: every line report_upstream can print,
  # on any machine, with no network and without touching the clone. What
  # cannot be faked is the derivation, because faking an origin means writing
  # into the clone and the check writes nothing there, so the coverage is a
  # precondition and the die names it rather than asserting nothing. The
  # shapes are written out here, as the command names are above: an assertion
  # that read them from the reporter would assert nothing.
  local answer="$SELFTEST_DIR/offline/answer" origin
  origin="$(git -C "$KIT_DIR" config --get remote.origin.url 2>/dev/null || true)"
  case "$origin" in
    git@github.com:*/*|ssh://git@github.com/*/*|https://github.com/*/*|http://github.com/*/*) ;;
    *) die "check 2: this clone's origin is not one the Upstream version derivation covers, so its three lines cannot be proven here (origin: ${origin:-none})" ;;
  esac
  # 99.0.0 is behind, 0.0.1 is the green line a clone ahead of origin gets,
  # the page is the answer that arrived and is not a version, and "-" is no
  # answer at all. The last two share a line, which is the point: a 404 page
  # taken for a number would be a warn that lies.
  for v in 99.0.0 0.0.1 '<!DOCTYPE html>' -; do
    case "$v" in
      99.0.0) printf '%s\n' "$v" > "$answer"
              expected="$(warn "kit source $KIT_VERSION, origin has 99.0.0 (git -C $KIT_DIR pull, then focus-kit update)")" ;;
      0.0.1)  printf '%s\n' "$v" > "$answer"
              expected="$(ok "kit source $KIT_VERSION (nothing newer on origin)")" ;;
      -)      rm -f "$answer"
              expected="$(warn "kit source $KIT_VERSION, origin did not answer (check by hand: git -C $KIT_DIR pull)")" ;;
      *)      printf '%s\n' "$v" > "$answer"
              expected="$(warn "kit source $KIT_VERSION, origin did not answer (check by hand: git -C $KIT_DIR pull)")" ;;
    esac
    out="$(doctor "$scratch" 2>&1)" || {
      printf '%s\n' "$out"
      die "check 2: doctor failed with the origin answering \"$v\""
    }
    printf '%s\n' "$out" | grep -qF -- "$expected" || {
      printf '%s\n' "$out"
      die "check 2: doctor did not report the kit source as expected with the origin answering \"$v\""
    }
  done
  rm -f "$answer"
  ok "2 install into a scratch repository, doctor agrees"
}

check_idempotent() { # scratch snapshot
  local scratch="$1" snapshot="$2" out
  cp -R "$scratch" "$snapshot" || die "check 3: could not copy the scratch repository"
  out="$(install_repo "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 3: the second install into the scratch repository failed"
  }
  out="$(diff -r -x .git "$snapshot" "$scratch" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 3: the second install changed the tree (install is not idempotent)"
  }
  ok "3 the second install leaves the same tree"
}

# Structural rules, in pure bash. python3 has no YAML parser in its standard
# library, and the failure this catches is structural: a bare colon in the
# description value breaks the YAML and the skill disappears with no error.
check_frontmatter() {
  local s file line n closing name desc_at desc_body bad state
  while IFS= read -r s; do
    file="$KIT_DIR/skills/$s/SKILL.md"
    [ -f "$file" ] || die "check 4: skills/$s/SKILL.md is missing"
    n=0; closing=0; name=""; desc_at=0; desc_body=0; bad=0; state=key
    while IFS= read -r line || [ -n "$line" ]; do
      n=$((n + 1))
      [ "$closing" -eq 0 ] || break
      if [ "$n" -eq 1 ]; then
        [ "$line" = "---" ] || die "check 4: skills/$s/SKILL.md does not open with --- on line 1"
        continue
      fi
      if [ "$line" = "---" ]; then closing=$n; continue; fi
      if [ "$state" = desc ]; then
        case "$line" in
          " "*)      desc_body=$((desc_body + 1)); continue ;;
          [A-Za-z]*) state=key ;;
          *)         bad=$n; break ;;
        esac
      fi
      case "$line" in
        name:*)            name="${line#name:}"; name="${name# }" ;;
        "description: >-") desc_at=$n; state=desc ;;
        description:*)     die "check 4: skills/$s/SKILL.md line $n is a description that is not a >- block" ;;
      esac
    done < "$file"
    [ "$closing" -gt 0 ]  || die "check 4: skills/$s/SKILL.md has no closing --- for its frontmatter"
    [ "$bad" -eq 0 ]      || die "check 4: skills/$s/SKILL.md line $bad is in the description block and not indented"
    [ "$name" = "$s" ]    || die "check 4: skills/$s/SKILL.md says name: $name, the folder is $s"
    [ "$desc_at" -gt 0 ]  || die "check 4: skills/$s/SKILL.md has no line reading exactly 'description: >-'"
    [ "$desc_body" -gt 0 ] || die "check 4: skills/$s/SKILL.md line $desc_at opens a description block with nothing in it"
  done <<< "$(kit_skills)"
  ok "4 the SKILL.md frontmatters are well formed"
}

# The character is built from its bytes and never written in this file, so
# the grep needs no allowlist (docs/04-Conventions.md §1). graphify-out/ is
# out of scope because graphify writes it.
check_no_em_dash() {
  local em hits
  em="$(printf '\xe2\x80\x94')"
  hits="$( { grep -rlF -- "$em" bin skills manuals config work CLAUDE.md README.md 2>/dev/null || true
             grep -rlF -- "$em" docs 2>/dev/null | grep -v '^docs/manuals/' || true ; } )"
  [ -z "$hits" ] || {
    printf '%s\n' "$hits"
    die "check 5: the em dash (U+2014) is in the files above"
  }
  ok "5 no em dash in the paths this repository authors"
}

check_dogfood() {
  local out stamp installed
  stamp="$KIT_DIR/.claude/skills/.focus-kit-version"
  [ -f "$stamp" ] || \
    die "check 6: the dogfood copy has no .focus-kit-version (run focus-kit install .)"
  installed="$(installed_version "$KIT_DIR")"
  [ "$installed" = "$KIT_VERSION" ] || \
    die "check 6: the dogfood copy is at $installed and VERSION is $KIT_VERSION (run focus-kit install .)"
  # Three exclusions and they are the three data files: none is a copy of
  # anything under skills/, so skills/ has no source for any of them. The stamp
  # and the manifest are what install writes; the Manual language record is what
  # /initialize writes, and it lands here for the same reason the other two do,
  # which is that copy_tree overwrites .claude/skills/<name>/ and not their
  # parent (docs/03-Domain.md, Manual language).
  out="$(diff -r -x .focus-kit-version -x .focus-kit-manifest -x .focus-kit-language skills .claude/skills 2>&1)" || {
    printf '%s\n' "$out"
    die "check 6: .claude/skills differs from skills (run focus-kit install .)"
  }
  out="$(diff -r manuals docs/manuals 2>&1)" || {
    printf '%s\n' "$out"
    die "check 6: docs/manuals differs from manuals (run focus-kit install .)"
  }
  # The third dogfood copy, and the one that cannot be a diff -r: skills/ holds
  # no tree of prompt files to compare against, because they are generated. The
  # comparison is against a regeneration from the same source, which is also
  # where the determinism of the transform is read back: two renderings of one
  # SKILL.md that differ would be a diff here.
  local s
  while IFS= read -r s; do
    # Presence first, or diff would fail on the missing file and render_prompt
    # would print into a pipe nobody reads any more.
    [ -f "$KIT_DIR/.github/prompts/$s.prompt.md" ] || \
      die "check 6: .github/prompts/$s.prompt.md is missing (run focus-kit install .)"
    out="$(render_prompt "$s" | diff - "$KIT_DIR/.github/prompts/$s.prompt.md" 2>&1)" || {
      printf '%s\n' "$out"
      die "check 6: .github/prompts/$s.prompt.md is not what skills/$s/SKILL.md renders (run focus-kit install .)"
    }
  done <<< "$(kit_skills)"
  # After both diffs, so it fires only on the gap they leave: the two copies
  # equal to their sources and the manifest stale against them, which is what
  # a source and a copy edited by hand in step produce. Only the presence of
  # the ok line is asserted; the warn lines this repository legitimately
  # produces are ignored, the way check 2 ignores a scratch repository's.
  out="$(doctor "$KIT_DIR" 2>&1)" || {
    printf '%s\n' "$out"
    die "check 6: doctor failed on this repository"
  }
  printf '%s\n' "$out" | grep -qF -- "$(ok "kit-owned files as install wrote them")" || {
    printf '%s\n' "$out"
    die "check 6: doctor reports drift in the dogfood copy (run focus-kit install .)"
  }
  ok "6 the dogfood copies match their sources"
}

selftest() {
  cd "$KIT_DIR"
  say "focus-kit $KIT_VERSION selftest"
  SELFTEST_DIR="$(mktemp -d)" || die "could not create a scratch directory (mktemp -d)"
  trap selftest_cleanup EXIT
  # The verify command makes no network call, on any check. report_upstream
  # reads with a program on PATH, so a fake one in front of it is the whole
  # answer: it prints the file beside it when there is one and fails when
  # there is not, which is the third line. It lives beside the scratch and
  # not in it, because check 3 snapshots the scratch, and the trap above
  # removes it. Its own directory and not the one the fake graphify uses,
  # which check 2 puts on PATH for four runs and nothing else. Exported here
  # rather than in check 2, because check 6 runs doctor on this repository
  # and has to stay offline for the same reason.
  mkdir -p "$SELFTEST_DIR/offline"
  {
    printf '%s\n' '#!/bin/sh'
    printf '%s\n' "[ -f \"$SELFTEST_DIR/offline/answer\" ] || exit 7"
    printf '%s\n' "cat \"$SELFTEST_DIR/offline/answer\""
  } > "$SELFTEST_DIR/offline/curl"
  chmod +x "$SELFTEST_DIR/offline/curl"
  PATH="$SELFTEST_DIR/offline:$PATH"
  export PATH
  check_parses
  check_install    "$SELFTEST_DIR/scratch"
  check_idempotent "$SELFTEST_DIR/scratch" "$SELFTEST_DIR/snapshot"
  check_frontmatter
  check_no_em_dash
  check_dogfood
  say
  say "selftest green: a target repository would receive a working kit"
}

# ---------------------------------------------------------------- main

cmd="${1:-}"
case "$cmd" in
  install|update)
    say "dependencies"
    ensure_uv
    ensure_graphify
    # Before anything is copied: this is the run that would otherwise write
    # the old kit into a target with nothing said. The install then goes on
    # and writes the version the clone holds.
    report_upstream
    say
    install_repo "${2:-.}"
    ;;
  doctor)   doctor "${2:-.}" ;;
  version)  say "$KIT_VERSION" ;;
  selftest) selftest ;;
  ""|-h|--help|help)
    awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
    ;;
  *) die "unknown command: $cmd (try: focus-kit help)" ;;
esac
